{
  "name": "@vue-brace/language-plugin-brace",
  "version": "0.1.0",
  "description": "Volar / Vue language tools plugin for lang=\"brace\" SFC templates",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./index.cjs",
      "default": "./dist/index.js"
    }
  },
  "files": ["dist", "index.cjs", "README.md", "LICENSE"],
  "scripts": {
    "prepack": "deno task --cwd=../.. build:plugin",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": ["vue", "volar", "language-server", "plugin", "template"],
  "dependencies": {
    "@vue-brace/brace-template": "^0.1.0",
    "@vue/language-core": "^3.3.11"
  },
  "peerDependencies": {
    "vue": "^3.5.0 || >=3.6.0-0"
  },
  "devDependencies": {
    "@vue/compiler-dom": "catalog:",
    "vitest": "^5.0.2",
    "vue": "catalog:"
  }
}
