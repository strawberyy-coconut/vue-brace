{
  "extends": "@vue/tsconfig/tsconfig.dom.json",
  "include": ["env.d.ts", "src/**/*", "src/**/*.vue"],
  "exclude": ["src/**/__tests__/*"],
  // Teaches Vue language tools about `lang="brace"` templates: Volar only reaches a
  // custom template language through the `compileSFCTemplate` plugin hook.
  //
  // Caveat: `vue-tsc` cannot run under Deno, so this is only exercised by the VS Code
  // extension here — see the repository README.
  "vueCompilerOptions": {
    "plugins": ["@vue-brace/language-plugin-brace"]
  },
  "compilerOptions": {
    // Extra safety for array and object lookups, but may have false positives.
    "noUncheckedIndexedAccess": true,

    // Path mapping for cleaner imports.
    "paths": {
      "@/*": ["./src/*"]
    },

    // `vue-tsc --build` produces a .tsbuildinfo file for incremental type-checking.
    // Specified here to keep it out of the root directory.
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo"
  }
}
